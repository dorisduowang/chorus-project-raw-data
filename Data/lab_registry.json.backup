  "compute": [
    {
      "id": "midway3",
      "name": "Midway3 HPC Cluster",
      "type": "hpc_cluster",
      "provider": "UChicago RCC",
      "description": "University's main research computing cluster using SLURM job scheduler",
      "access": "rcc_account_required",
      "account": "pi-jevans",
      "connection": "https://rcc-uchicago.github.io/user-guide/ssh/main",
      "storage": {
        "project_path": "/project/jevans/",
        "project_capacity_tb": 100,
        "scratch_path": "/scratch/midway3/{username}/",
        "scratch_capacity_tb_per_user": 2,
        "notes": "Scratch is not backed up. Use 'quota' command to check usage."
      },
      "partitions": {
        "university_wide": {
          "caslake": {
            "description": "Regular compute nodes",
            "cores_per_node": 48,
            "ram_gb": 192,
            "walltime_hours": 36,
            "account": "pi-jevans"
          },
          "gpu": {
            "description": "GPU nodes with mixed GPU types",
            "gpu_types": [
              "rtx6000",
              "v100",
              "a100"
            ],
            "gpu_nodes": {
              "rtx6000": 5,
              "v100": 5,
              "a100": 1
            },
            "walltime_hours": 36,
            "account": "pi-jevans",
            "constraint_flag": "--constraint=v100"
          },
          "bigmem": {
            "description": "High memory nodes",
            "cores_per_node": 48,
            "ram_tb": "1.5-2",
            "walltime_hours": 36,
            "account": "pi-jevans"
          },
          "amd": {
            "description": "AMD processor nodes (slower cores, more parallelism)",
            "cores_per_node": 128,
            "ram_gb": 256,
            "walltime_hours": 36,
            "account": "pi-jevans"
          }
        },
        "social_sciences": {
          "ssd": {
            "description": "Social Sciences Division partition",
            "nodes": 18,
            "walltime_hours": 36,
            "account": "ssd",
            "notes": "Few users, often good availability"
          },
          "ssd-gpu": {
            "description": "SSD GPU partition",
            "nodes": 1,
            "gpus": 4,
            "gpu_type": "A100",
            "walltime_hours": 36,
            "account": "ssd",
            "qos": "ssd",
            "notes": "Set --qos=ssd, not --qos=ssd-gpu"
          }
        },
        "lab_owned": {
          "jevans": {
            "description": "Knowledge Lab dedicated partition",
            "nodes": 4,
            "type": "bigmem",
            "ram_tb": "1.5-2",
            "cores_per_node": 48,
            "walltime_hours": 48,
            "account": "pi-jevans"
          },
          "jevans-gpu": {
            "description": "Knowledge Lab GPU partition",
            "nodes": 1,
            "gpus": 4,
            "gpu_type": "H100",
            "vram_gb_per_gpu": 94,
            "ram_gb": 500,
            "cores": 32,
            "walltime_hours": 48,
            "account": "pi-jevans",
            "notes": "Reserve for GPU-requiring jobs only"
          }
        }
      },
      "documentation": "https://rcc-uchicago.github.io/user-guide/partitions/",
      "allocation_renewal": "September annually",
      "useful_commands": [
        "myq",
        "squeue",
        "sinfo",
        "scontrol show job",
        "quota",
        "accounts balance"
      ]
    },
