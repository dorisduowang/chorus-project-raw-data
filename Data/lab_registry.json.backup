    {
      "id": "slurm",
      "name": "SLURM",
      "type": "job_scheduler",
      "url": null,
      "description": "Job scheduler used on Midway3 for batch and interactive jobs",
      "platforms": [
        "midway3"
      ],
      "useful_commands": {
        "myq": "Show your current running and pending jobs",
        "squeue | grep jevans": "Show all jobs on jevans partitions",
        "sinfo | grep jevans": "Show status of nodes on jevans partitions",
        "scontrol show job [jobid]": "Show detailed job information"
      },
      "job_types": {
        "batch": "Set-and-forget jobs using sbatch",
        "interactive": "Real-time interaction via sinteractive",
        "job_arrays": "Run same code multiple times with different parameters"
      },
      "documentation": "https://rcc-uchicago.github.io/user-guide/slurm/sbatch",
      "notes": "Request ~20% more memory/time than needed. For single-threaded code, request 2 CPUs. Use --exclusive flag to reserve entire node."
    },
    {
      "id": "pyspark",
      "name": "PySpark",
      "type": "data_processing",
      "url": null,
      "description": "Apache Spark with Python interface for distributed data processing on Midway",
      "platforms": [
        "midway3"
      ],
      "setup": {
        "module_load": "module load spark",
        "recommended_memory": "100g per executor",
        "best_partitions": [
          "caslake",
          "ssd"
        ],
        "notes": "Works well with 1+ exclusive nodes. AMD partitions work but may have lower throughput."
      },
      "example_session": "spark = SparkSession.builder.config('spark.executor.memory', '100g').appName('pyspark').getOrCreate()",
      "documentation": "See klab_computing_manual.md for startup scripts"
    },
