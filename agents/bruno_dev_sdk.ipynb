   "source": "async def run_chorus(query: str, thread_id: str = \"dev-session\") -> dict:\n    \"\"\"Run a Chorus query with voice profiles and conversation memory.\n\n    Args:\n        query: The user's question.\n        thread_id: Conversation thread ID for memory continuity.\n                   Use the same thread_id for follow-up questions.\n    \"\"\"\n    system_prompt = build_system_prompt(query)\n\n    async with MultiServerMCPClient(MCP_CONFIG) as client:\n        rag_tools = await client.get_tools()\n        tools = rag_tools + [calculator]\n        print(f\"Tools loaded: {[t.name for t in tools]}\")\n\n        agent = create_react_agent(\n            model,\n            tools=tools,\n            prompt=system_prompt,\n            checkpointer=checkpointer,\n        )\n\n        result = await agent.ainvoke(\n            {\"messages\": [{\"role\": \"user\", \"content\": query}]},\n            config={\"configurable\": {\"thread_id\": thread_id}},\n        )\n        return result\n\n\n# Test: run a single query\nresult = await run_chorus(\"Tell me about the Knowledge Lab and what it does.\")\n\n# Print just the final AI response\nai_messages = [m for m in result[\"messages\"] if m.type == \"ai\" and m.content]\nif ai_messages:\n    print(ai_messages[-1].content)",
