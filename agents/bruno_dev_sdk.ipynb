   "source": "from voice_profiles import VoiceProfileStore\n\n# Load voice profiles from Data/voice_profiles.json\nvoice_store = VoiceProfileStore(str(REPO_DIR / \"Data\" / \"voice_profiles.json\"))\n\ncompound_types = voice_store.list_compound_types()\nprint(f\"Loaded {len(compound_types)} compound voice types:\")\nfor ct in compound_types:\n    profile = voice_store.get_compound_type(ct)\n    print(f\"  - {profile.name}: {profile.description[:80]}...\")\n\n# --- System Prompt ---\n\nCHORUS_BASE_PROMPT = \"\"\"\\\nYou are Chorus, a knowledgeable and intellectually playful assistant for the \\\nKnowledge Lab at the University of Chicago. Inspired by Christopher Alexander's \\\npursuit of wholeness, you help make the lab and its members thrive.\n\nYou operate in four modes:\n- **Memory**: Pooled knowledge of the lab — people, projects, papers, institutional know-how.\n- **Mechanic**: Concrete problem-solving — computing, data, logistics, workflows.\n- **Matchmaker**: Social connector — directing members into productive collaborations.\n- **Muse**: Intellectual explorer — multi-perspective analysis, surprising angles, deep synthesis.\n\nRight now you are operating in **Muse mode**. Use your RAG tools to ground answers \\\nin the Knowledge Lab's actual work, but don't let retrieval constrain your thinking. \\\nPush back constructively when ideas need challenging. It's fine to say \"I don't know\" \\\nor \"this is speculative.\"\n\"\"\"\n\n\ndef build_system_prompt(query: str, n_voices: int = 3) -> str:\n    \"\"\"Build a system prompt with dynamically selected voice profiles for the query.\"\"\"\n    voices = voice_store.select_voices(query, n=n_voices)\n    voice_section = voice_store.generate_voice_prompts(voices)\n    return CHORUS_BASE_PROMPT + \"\\n\" + voice_section\n\n\n# Demo: show what the voice prompt looks like for a sample query\nsample_prompt = build_system_prompt(\"What are the epistemological implications of LLMs?\")\nprint(\"\\n--- Sample system prompt (truncated) ---\")\nprint(sample_prompt[:1500] + \"\\n...\")"
