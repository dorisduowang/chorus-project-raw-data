   "source": "%pip install -q langchain-anthropic langchain-mcp-adapters langgraph python-dotenv nest_asyncio\n\nimport os, sys, ast, operator\nfrom pathlib import Path\n\nimport nest_asyncio\nnest_asyncio.apply()\n\nfrom dotenv import load_dotenv\n\n# Resolve repo root (works from agents/ directory)\nREPO_DIR = Path.cwd().parent if Path.cwd().name == \"agents\" else Path.cwd()\nprint(f\"Repo root: {REPO_DIR}\")\n\n# Add repo root to sys.path so project modules can be imported\nif str(REPO_DIR) not in sys.path:\n    sys.path.insert(0, str(REPO_DIR))\n\n# Load .env — try repo root, fall back to env var already set\nenv_path = REPO_DIR / \".env\"\nif env_path.exists():\n    load_dotenv(env_path)\n    print(f\"Loaded .env from {env_path}\")\nelse:\n    print(f\"No .env at {env_path} — using shell environment\")\n\nassert os.environ.get(\"ANTHROPIC_API_KEY\"), (\n    \"ANTHROPIC_API_KEY not set. Copy .env.example to .env and fill in your key.\"\n)\n\nfrom langchain_anthropic import ChatAnthropic\nfrom langchain_mcp_adapters.client import MultiServerMCPClient\nfrom langgraph.prebuilt import create_react_agent\nfrom langgraph.checkpoint.memory import MemorySaver\nfrom langchain_core.tools import tool\n\n\n# Safe math evaluator using AST — no eval()\n_SAFE_OPS = {\n    ast.Add: operator.add,\n    ast.Sub: operator.sub,\n    ast.Mult: operator.mul,\n    ast.Div: operator.truediv,\n    ast.FloorDiv: operator.floordiv,\n    ast.Mod: operator.mod,\n    ast.Pow: operator.pow,\n    ast.USub: operator.neg,\n    ast.UAdd: operator.pos,\n}\n\ndef _safe_eval(node):\n    \"\"\"Recursively evaluate an AST node using only arithmetic operations.\"\"\"\n    if isinstance(node, ast.Expression):\n        return _safe_eval(node.body)\n    if isinstance(node, ast.Constant) and isinstance(node.value, (int, float)):\n        return node.value\n    if isinstance(node, ast.BinOp) and type(node.op) in _SAFE_OPS:\n        left = _safe_eval(node.left)\n        right = _safe_eval(node.right)\n        if isinstance(node.op, ast.Pow) and right > 1000:\n            raise ValueError(\"Exponent too large\")\n        return _SAFE_OPS[type(node.op)](left, right)\n    if isinstance(node, ast.UnaryOp) and type(node.op) in _SAFE_OPS:\n        return _SAFE_OPS[type(node.op)](_safe_eval(node.operand))\n    raise ValueError(f\"Unsupported expression: {ast.dump(node)}\")\n\n@tool\ndef calculator(expression: str) -> str:\n    \"\"\"Evaluate a math expression for cost calculations. Supports +, -, *, /, //, %, **.\"\"\"\n    try:\n        tree = ast.parse(expression, mode=\"eval\")\n        return str(_safe_eval(tree))\n    except (ValueError, TypeError, ZeroDivisionError, SyntaxError) as e:\n        return f\"Error evaluating expression: {e}\"\n\n\n# Model — env-configurable, defaults to match MuseAgent.DEFAULT_MODEL\nMODEL_NAME = os.environ.get(\"MODEL_NAME\", \"claude-sonnet-4-20250514\")\nmodel = ChatAnthropic(model=MODEL_NAME)\nprint(f\"Model: {MODEL_NAME}\")\n\n# MCP server config — starts mcp_rag_server.py as a subprocess over stdio\nMCP_PYTHON = sys.executable  # use same Python that's running this notebook\nMCP_CONFIG = {\n    \"chorus-rag\": {\n        \"transport\": \"stdio\",\n        \"command\": MCP_PYTHON,\n        \"args\": [str(REPO_DIR / \"scripts\" / \"mcp_rag_server.py\")],\n        \"cwd\": str(REPO_DIR),\n        \"env\": {\"ANTHROPIC_API_KEY\": os.environ[\"ANTHROPIC_API_KEY\"]},\n    }\n}\n\n# Session-scoped conversation memory\ncheckpointer = MemorySaver()\n\nprint(f\"MCP Python: {MCP_PYTHON}\")\nprint(\"Setup complete.\")"
