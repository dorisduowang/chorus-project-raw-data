   "source": "import random\n\n# Seed for reproducible output in demos\nrandom.seed(42)\n\n# --- Voice Profile Explorer ---\n# Useful for development/debugging of the voice system.\n\nprint(\"=\" * 60)\nprint(\"VOICE PROFILE EXPLORER\")\nprint(\"=\" * 60)\n\n# 1. Show all compound types with full details\nfor name in voice_store.list_compound_types():\n    ct = voice_store.get_compound_type(name)\n    print(f\"\\n--- {ct.name} ---\")\n    print(f\"Description: {ct.description}\")\n    print(f\"Exemplars: {', '.join(ct.exemplars)}\")\n    print(f\"Disposition: {ct.disposition.describe()}\")\n    tensions = ct.critique_behavior.productive_tensions\n    if tensions:\n        print(f\"Productive tensions with: {', '.join(tensions)}\")\n\n# 2. Topic-based selection\nprint(f\"\\n{'='*60}\")\nprint(\"TOPIC-BASED SELECTION\")\nprint(f\"{'='*60}\")\n\ntopic_tests = [\n    [\"interdisciplinary\", \"analogy\"],\n    [\"math\", \"proof\"],\n    [\"paradigm\", \"assumption\"],\n]\n\nfor topics in topic_tests:\n    voices = voice_store.select_voices_by_topic(topics, n=3)\n    names = [v.name for v in voices]\n    print(f\"\\nTopics {topics}:\")\n    print(f\"  Selected: {names}\")\n\n# 3. Query-based selection\nprint(f\"\\n{'='*60}\")\nprint(\"QUERY-BASED SELECTION\")\nprint(f\"{'='*60}\")\n\nquery_tests = [\n    \"How can we formalize the structure of interdisciplinary collaboration?\",\n    \"What patterns emerge in large-scale citation networks over decades?\",\n    \"Can we use improv comedy techniques to improve brainstorming sessions?\",\n]\n\nfor query in query_tests:\n    random.seed(42)  # Reset seed for reproducibility per query\n    voices = voice_store.select_voices(query, n=3)\n    names = [v.name if hasattr(v, 'name') else v.id for v in voices]\n    print(f\"\\nQuery: \\\"{query[:70]}...\\\"\")\n    print(f\"  Selected: {names}\")",
