   "source": "# Multi-query demo battery\n# Runs all queries in one MCP session to avoid repeated subprocess startup.\n# The follow-up query tests MemorySaver context — \"they\" should resolve from prior conversation.\n\nDEMO_QUERIES = [\n    (\"Who is James Evans and what does he research?\", \"lookup\"),\n    (\"How do I access the computing cluster?\", \"technical\"),\n    (\"What are the epistemological implications of using LLMs as research tools?\", \"explore\"),\n    (\"Who in the lab works on computational social science?\", \"connect\"),\n    (\"What specific papers have they published recently?\", \"follow-up\"),  # tests memory\n]\n\nDEMO_THREAD = \"demo-battery\"\n\nasync def run_demo_battery():\n    \"\"\"Run all demo queries in a single MCP session with shared conversation memory.\"\"\"\n    async with MultiServerMCPClient(MCP_CONFIG) as client:\n        rag_tools = await client.get_tools()\n        tools = rag_tools + [calculator]\n        print(f\"Tools: {[t.name for t in tools]}\\n\")\n\n        for i, (query, qtype) in enumerate(DEMO_QUERIES, 1):\n            print(f\"{'='*60}\")\n            print(f\"Query {i}/{len(DEMO_QUERIES)} [{qtype}]: {query}\")\n            print(f\"{'='*60}\")\n\n            system_prompt = build_system_prompt(query)\n            agent = create_react_agent(\n                model,\n                tools=tools,\n                prompt=system_prompt,\n                checkpointer=checkpointer,\n            )\n\n            result = await agent.ainvoke(\n                {\"messages\": [{\"role\": \"user\", \"content\": query}]},\n                config={\"configurable\": {\"thread_id\": DEMO_THREAD}},\n            )\n\n            ai_messages = [m for m in result[\"messages\"] if m.type == \"ai\" and m.content]\n            if ai_messages:\n                response = ai_messages[-1].content\n                # Show first 500 chars to keep output manageable\n                preview = response[:500] + (\"...\" if len(response) > 500 else \"\")\n                print(f\"\\n{preview}\\n\")\n\nawait run_demo_battery()",
