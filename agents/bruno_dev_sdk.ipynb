   "source": "from IPython.display import display, Markdown, clear_output\n\n\nasync def run_chorus_streaming(query: str, thread_id: str = \"dev-session\"):\n    \"\"\"Run a Chorus query with live streaming output in Jupyter.\n\n    Streams token-by-token, rendering accumulated markdown in-place.\n    Also prints tool invocations for visibility into the ReAct loop.\n    \"\"\"\n    system_prompt = build_system_prompt(query)\n\n    async with MultiServerMCPClient(MCP_CONFIG) as client:\n        rag_tools = await client.get_tools()\n        tools = rag_tools + [calculator]\n\n        agent = create_react_agent(\n            model,\n            tools=tools,\n            prompt=system_prompt,\n            checkpointer=checkpointer,\n        )\n\n        collected = \"\"\n        md_handle = display(Markdown(\"*Thinking...*\"), display_id=True)\n\n        async for event in agent.astream_events(\n            {\"messages\": [{\"role\": \"user\", \"content\": query}]},\n            config={\"configurable\": {\"thread_id\": thread_id}},\n            version=\"v2\",\n        ):\n            kind = event[\"event\"]\n\n            if kind == \"on_chat_model_stream\":\n                chunk = event[\"data\"][\"chunk\"]\n                if hasattr(chunk, \"content\") and isinstance(chunk.content, str):\n                    collected += chunk.content\n                    md_handle.update(Markdown(collected))\n\n            elif kind == \"on_tool_start\":\n                tool_name = event.get(\"name\", \"unknown\")\n                print(f\"  >> Tool: {tool_name}\")\n\n        # Final render\n        md_handle.update(Markdown(collected))\n        return collected\n\n\n# Demo: stream a response\nprint(\"Streaming demo:\\n\")\n_ = await run_chorus_streaming(\n    \"What research methods does the Knowledge Lab use?\",\n    thread_id=\"stream-demo\",\n)",
